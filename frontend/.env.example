VITE_APP_NAME=หมากระทุปุ๊ป๊ะ

# Supabase — หาได้ที่ Dashboard > Project Settings > API Keys
# คีย์ทั้งสองตัวนี้เป็นคีย์ฝั่ง client ที่เปิดเผยได้
# ความปลอดภัยของข้อมูลขึ้นอยู่กับ Row Level Security ที่ตั้งไว้ในฐานข้อมูล
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# เส้นทางที่โค้ดฝั่ง client ใช้เรียก API — ปล่อยเป็น /api แล้วให้ dev server proxy ให้
VITE_API_BASE_URL=/api

# ปลายทางที่ dev server จะ proxy /api ไปให้ เลือกอย่างใดอย่างหนึ่ง
#   Edge Function ที่ deploy แล้ว (ใช้ได้ทันที)
VITE_PROXY_TARGET=https://<project-ref>.supabase.co/functions/v1
#   หรือรันฟังก์ชันในเครื่องด้วย `supabase functions serve` แล้วใช้
# VITE_PROXY_TARGET=http://localhost:54321/functions/v1
